<?xml version="1.0" encoding="utf-8"?>
<component type="desktop-application">
  <id>com.fynix.hub</id>
  <name>Fynix Hub</name>
  <summary>Media Hub with Netflix-like experience</summary>
  <developer>
    <name>Boc</name>
  </developer>
  <description>
    <p>Fynix Hub is a modern media center application that brings together streaming, live TV, and sports into a single Netflix-like interface. Powered by Real-Debrid integration for high-quality torrent streaming.</p>
    <p>Features:</p>
    <ul>
      <li>Browse and stream movies &amp; TV shows with a beautiful Netflix-style UI</li>
      <li>Real-Debrid, TorBox, Premiumize, and AllDebrid integration for cached torrent streaming</li>
      <li>Live TV channels from around the world</li>
      <li>Sports hub with live schedules, results, and replays</li>
      <li>Remote control support (MPV player)</li>
      <li>Trakt.tv scrobbling and watchlist sync</li>
      <li>Subtitle support via OpenSubtitles</li>
      <li>Torrent search across multiple indexers</li>
      <li>Customizable categories and content filtering</li>
    </ul>
  </description>
