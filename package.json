{
  "name": "fynix-hub",
  "productName": "Fynix Hub",
  "version": "2.3.2",
  "description": "Media Hub with Netflix-like experience",
  "main": ".vite/build/index.js",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "postinstall": "patch-package",
    "setup:ffmpeg": "bash scripts/setup-ffmpeg.sh",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "media",
    "torrent",
    "streaming"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron-forge/publisher-github": "^7.11.2",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/webtorrent": "^0.110.1",
    "electron": "^42.4.1",
    "jsdom": "^29.1.1",
    "msw": "^2.15.0",
    "patch-package": "^8.0.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@videojs/react": "^10.0.0-beta.25",
    "axios": "^1.18.1",
    "better-sqlite3": "^12.11.1",
    "electron-updater": "^6.8.9",
    "fast-xml-parser": "^5.9.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "theintrodb": "^3.1.1",
    "webtorrent": "^3.0.16",
    "youtube-dl-exec": "^3.1.8",
    "zustand": "^5.0.14"
  }
